{
    "branches": [
        "main",
        "master",
        "next",
        "next-major",
        "+([0-9])?(.{+([0-9]),x}).x",
        {
            "name": "beta",
            "prerelease": true
        },
        {
            "name": "alpha",
            "prerelease": true
        }
    ],
    "plugins": [
        "semantic-release-gitmoji",
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "UV_LOCKED=0 uv version --frozen ${nextRelease.version} && uv build && UV_LOCKED=0 uv version --frozen 0.0.0"
            }
        ],
        [
            "@semantic-release/github",
            {
                "assets": [
                    {
                        "path": "dist/*.whl"
                    },
                    {
                        "path": "dist/*.tar.gz"
                    }
                ]
            }
        ]
    ]
}
